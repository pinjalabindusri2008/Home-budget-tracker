
from pathlib import Path
import pandas as pd
import numpy as np
import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt


STATIC_DIR = Path(__file__).resolve().parent / "static"
STATIC_DIR.mkdir(parents=True, exist_ok=True)

data = {
    "month": [
        "2026-09", "2026-09",
        "2026-10", "2026-10"
    ],
    "transaction_type": [
        "Income", "Expense",
        "Income", "Expense"
    ],
    "amount": [
        45000, 14000,
        50000, 22000
    ]
}

# Create Pandas DataFrame
df = pd.DataFrame(data)

# Convert transaction types to lowercase
df["transaction_type"] = df["transaction_type"].str.lower()

monthly = df.groupby(
    ["month", "transaction_type"]
)["amount"].sum().unstack(fill_value=0)

monthly = monthly.reindex(
    columns=["income", "expense"],
    fill_value=0
)

#
monthly["savings"] = np.subtract(
    monthly["income"],
    monthly["expense"]
)

print("MONTHLY FINANCIAL ANALYSIS")
print("--------------------------")
print(monthly)


plt.figure(figsize=(9, 5))

plt.plot(
    monthly.index,
    monthly["income"],
    marker="o",
    label="Income",
    color="green",
    linewidth=2
)

plt.plot(
    monthly.index,
    monthly["expense"],
    marker="o",
    label="Expenses",
    color="red",
    linewidth=2
)

plt.title("Monthly Income vs Expenses")
plt.xlabel("Month")
plt.ylabel("Amount (INR)")
plt.legend()
plt.grid(alpha=0.3)

plt.tight_layout()

plt.savefig(
    STATIC_DIR / "monthly_comparison.png",
    dpi=150
)

plt.close()

print("\nMonthly Comparison Chart Created Successfully!")
print("Saved in:", STATIC_DIR / "monthly_comparison.png")
